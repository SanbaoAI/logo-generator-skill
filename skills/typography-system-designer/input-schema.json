{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypographySystemDesignerInput",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "brand_tone": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": ["zh-CN", "en", "mixed"]
    },
    "surface": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "body_copy_density": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "font_preference": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
