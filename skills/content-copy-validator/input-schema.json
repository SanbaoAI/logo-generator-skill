{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentCopyValidatorInput",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "copy": {
      "type": "string"
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": ["zh-CN", "en", "mixed"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  },
  "additionalProperties": true
}
